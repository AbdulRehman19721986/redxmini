# ─────────────────────────────────────────────────────────────
#  RedX-Mini-MD — environment variables
#  Copy this file to .env and fill in the values you need.
#  Anything left blank falls back to the default in config.js.
# ─────────────────────────────────────────────────────────────

# REQUIRED — MongoDB Atlas credentials used for multi-session pairing storage.
# Keep these values in your host's secret/environment settings, not in source control.
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_URI=

# Web server port (Render/Railway/Heroku set this automatically)
PORT=3000

# Bot owner WhatsApp number(s), comma-separated, no + sign
OWNER_NUMBERS=923009842133

# public | private | group | inbox
WORK_TYPE=public

# Command prefix (default: .)
PREFIX=.

# ── Optional integrations ──────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GIPHY_API_KEY=
OPENWEATHER_KEY=

# ── Group welcome / goodbye ─────────────────────────────────────
WELCOME_ENABLE=true
WELCOME_MSG=
WELCOME_IMAGE=
GOODBYE_ENABLE=true
GOODBYE_MSG=
GOODBYE_IMAGE=

# ── Brand / channel tag rebrand (see settings.js) ───────────────
CHANNEL_JID=120363405513439052@newsletter
CHANNEL_NAME=REDX-MINI-MD | Abdul Rehman Rajpoot
CHANNEL_LINK=https://whatsapp.com/channel/0029VbCPnYf96H4SNehkev10
WHATSAPP_GROUP=https://chat.whatsapp.com/LhSmx2SeXX75r8I2bxsNDo

# ── Optional alternate DB backends for feature-settings store ──
# (lazy-loaded — only touched if you set these; npm install mysql2 / pg first)
MYSQL_URL=
POSTGRES_URL=
