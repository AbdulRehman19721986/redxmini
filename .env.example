# ── REDX Deployment Bridge — .env.example ────────────────────────────────
# This PUBLIC repo does not run the application.
# This file documents the variable NAMES the private application expects.
#
# Set real values ONLY in:
#   • The private repo's platform environment (Render/Railway/Heroku dashboard)
#   • The private repo's GitHub Actions secrets
#
# NEVER put real values in this file.
# NEVER commit a filled-in .env anywhere.
# ─────────────────────────────────────────────────────────────────────────

# Bot identity
BOT_NAME=
OWNER_NAME=
OWNER_NUMBER=

# Bot behaviour
PREFIX=
BOT_MODE=

# Admin panel (CHANGE FROM DEFAULTS — do not use "redx"/"redx")
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Database — MongoDB (primary)
MONGO_URL=

# Database — Supabase (sessions + settings mirror)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Channel JID
NEWSLETTER_JID=

# Hosting
PORT=
APP_URL=

# ── Deployment secrets (private repo / platform only) ─────────────────────
# These never go in source. Listed here for documentation only.
# RENDER_DEPLOY_HOOK=
# RAILWAY_TOKEN=
# HEROKU_API_KEY=
